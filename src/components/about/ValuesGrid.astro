---
const { values } = Astro.props;
---
<div class="grid gap-4 md:grid-cols-2">
  {values.map((value) => (
    <article class="about-value-card" data-value-id={value.id}>
      <span class="about-value-index">{value.index}</span>
      <div>
        <h3 class="text-xl font-semibold text-white">{value.title}</h3>
        <p class="mt-3 max-w-md text-sm leading-6 text-white/55">{value.copy}</p>
      </div>
    </article>
  ))}
</div>
