---
const { eyebrow, title, copy, image = '/assets/baltinache.jpg', cta = '/tours', ctaLabel = 'Explore Tours' } = Astro.props;
---
<main>
  <section class="relative min-h-screen overflow-hidden bg-black pt-20">
    <img src={image} alt="" class="absolute inset-0 h-full w-full object-cover"/>
    <div class="absolute inset-0 bg-black/70"></div><div class="absolute inset-0 bg-gradient-to-t from-ink via-transparent to-black/20"></div>
    <div class="container-page relative z-10 flex min-h-[calc(100vh-5rem)] items-center py-20"><div class="max-w-3xl"><p class="eyebrow">{eyebrow}</p><h1 class="mt-4 font-serif text-5xl md:text-7xl">{title}</h1><p class="mt-6 max-w-xl text-base leading-7 text-white/65">{copy}</p><a href={cta} class="btn-primary mt-8">{ctaLabel} <span>→</span></a></div></div>
  </section>
</main>
