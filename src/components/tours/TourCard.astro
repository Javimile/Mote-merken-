---
const { tour } = Astro.props;
---
<article class="tour-card group" data-tour-card data-region={tour.region} data-experience={tour.experience} data-format={tour.format}>
  <a href={`/tours/${tour.slug}`} class="block">
    <div class="relative aspect-[4/3] overflow-hidden">
      <img src={tour.image} alt={tour.name} class="h-full w-full object-cover transition duration-700 group-hover:scale-105"/>
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div>
      <span class="absolute left-4 top-4 rounded-full border border-white/20 bg-black/45 px-3 py-1 text-[10px] uppercase tracking-[.16em] text-white/75 backdrop-blur">{tour.format}</span>
    </div>
    <div class="p-5 md:p-6">
      <div class="flex items-start justify-between gap-4">
        <div><p class="text-[10px] font-bold uppercase tracking-[.2em] text-sand-light">{tour.eyebrow}</p><h2 class="mt-2 font-serif text-3xl">{tour.name}</h2></div>
        <span class="mt-1 text-lg text-sand-light transition group-hover:translate-x-1">→</span>
      </div>
      <p class="mt-2 text-xs uppercase tracking-[.14em] text-white/45">{tour.location} · {tour.experience}</p>
      <p class="mt-4 text-sm leading-6 text-white/60">{tour.summary}</p>
      <div class="mt-5 flex items-center justify-between border-t border-white/10 pt-4 text-xs"><span class="text-white/45">Schedule & rate on request</span><span class="font-bold text-white group-hover:text-sand-light">View Tour</span></div>
    </div>
  </a>
</article>
