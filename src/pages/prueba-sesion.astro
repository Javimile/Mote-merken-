<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Prueba de sesión</title>
  </head>

  <body>
    <h1>Prueba de sesión</h1>

    <pre id="resultado">Consultando sesión...</pre>

    <script>
      import { obtenerUsuarioActual } from '../lib/auth.js';

      const resultado = document.querySelector('#resultado');

      obtenerUsuarioActual()
        .then((data) => {
          if (!data) {
            resultado.textContent = '❌ No hay una sesión activa.';
            return;
          }

          resultado.textContent = JSON.stringify(data, null, 2);
        })
        .catch((error) => {
          console.error(error);
          resultado.textContent = `Error: ${error.message}`;
        });
    </script>
  </body>
</html>