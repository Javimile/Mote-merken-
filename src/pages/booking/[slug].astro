---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BookingFlow from '../../components/booking/BookingFlow.astro';
import { tours } from '../../data/tours';
import { getBookingSeed } from '../../data/booking';

export function getStaticPaths() {
  return tours.map((tour) => ({ params: { slug: tour.slug }, props: { tour } }));
}
const { tour } = Astro.props;
const booking = getBookingSeed(tour.slug);
if (!booking) throw new Error(`Missing booking configuration for ${tour.slug}`);
---
<BaseLayout title={`Book ${tour.name} | Mote Merkén Travel`}>
  <Header active="booking" />
  <main class="min-h-screen bg-ink pt-20">
    <section class="relative overflow-hidden border-b border-white/10 bg-panel py-14 md:py-16">
      <div class="absolute inset-0 opacity-[.14]"><img src={tour.image} alt="" class="h-full w-full object-cover" /></div>
      <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/95 to-ink/65"></div>
      <div class="container-page relative z-10">
        <a href={`/tours/${tour.slug}`} class="route-link">← Back to {tour.name}</a>
        <p class="eyebrow mt-8">Booking · {tour.id}</p>
        <h1 class="mt-3 max-w-4xl font-serif text-5xl md:text-7xl">Reserve {tour.name}</h1>
        <p class="mt-5 max-w-2xl text-sm leading-7 text-white/55">Choose an available date and schedule. The approval and Webpay steps below are a frontend simulation prepared for the future Django workflow.</p>
      </div>
    </section>

    <section class="py-12 md:py-16">
      <div class="container-page"><BookingFlow tour={tour} booking={booking} /></div>
    </section>
  </main>
  <Footer />
</BaseLayout>
