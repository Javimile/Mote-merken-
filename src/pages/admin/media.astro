---
import AdminLayout from '../../layouts/AdminLayout.astro'; import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
const media=[['/assets/rapa-nui.jpg','Rapa Nui','Image'],['/assets/pucon.jpg','Pucón','Image'],['/assets/santiago.jpg','Santiago','Image'],['/assets/baltinache.jpg','Atacama','Image'],['/assets/spa-experience.jpg','Wellness','Image'],['/assets/drone-valle.mp4','Drone Valle','Video']];
---
<AdminLayout title="Media library" active="media"><AdminPageHeader title="Media library" description="Upload, preview, organize and remove images or videos used by the public site." actionLabel="Upload media" actionId="admin-upload-media" /><div class="admin-toolbar mt-7"><input id="media-search" placeholder="Search media..."/><select id="media-filter"><option value="all">All media</option><option value="Image">Images</option><option value="Video">Videos</option></select></div><section id="media-grid" class="admin-media-grid mt-5">{media.map(([src,name,type])=><article class="admin-media-card" data-type={type}>{type==='Video'?<div class="admin-video-placeholder">▶<small>VIDEO</small></div>:<img src={src} alt={name}/>}<div><small class="media-type">{type}</small><h2 class="media-name">{name}</h2><p>Linked asset · frontend prototype</p><div class="admin-card-actions"><button class="media-cover">Set cover</button><button class="media-edit">Edit</button><button class="danger media-delete">Delete</button></div></div></article>)}</section>
<dialog id="media-dialog" class="admin-modal"><form id="media-form"><div class="admin-modal-head"><div><p>Media library</p><h2>Upload media</h2></div><button type="button" data-close class="admin-modal-close">×</button></div><div class="admin-modal-body"><div class="admin-form-grid"><label class="admin-field"><span>Display name</span><input id="media-name" required /></label><label class="admin-field"><span>Use in</span><select id="media-link"><option>Tour</option><option>Destination</option><option>Experience</option><option>General site</option></select></label><label class="admin-field full"><span>Image or video</span><input id="media-file" type="file" accept="image/*,video/*" required /></label><div id="media-preview" class="admin-image-preview full">Choose a file to preview</div></div></div><div class="admin-modal-actions"><button type="button" data-close class="admin-secondary-btn">Cancel</button><button class="admin-primary-btn">Add media</button></div></form></dialog><div id="admin-toast" class="admin-toast"></div>
<script is:inline>
const dlg=document.querySelector('#media-dialog'),form=document.querySelector('#media-form'),grid=document.querySelector('#media-grid'),toast=document.querySelector('#admin-toast');let fileData='',fileType='Image';const note=m=>{toast.textContent=m;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),1800)};document.querySelector('#admin-upload-media').onclick=()=>{form.reset();fileData='';document.querySelector('#media-preview').innerHTML='Choose a file to preview';dlg.showModal()};document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>dlg.close());document.querySelector('#media-file').onchange=e=>{const f=e.target.files?.[0];if(!f)return;fileType=f.type.startsWith('video')?'Video':'Image';const r=new FileReader();r.onload=()=>{fileData=r.result;document.querySelector('#media-preview').innerHTML=fileType==='Image'?`<img src="${fileData}">`:'<div class="admin-video-placeholder">▶<small>VIDEO SELECTED</small></div>'};r.readAsDataURL(f)};
function bind(c){c.querySelector('.media-delete').onclick=async()=>{const ok=await AdminUI.confirm({tone:'danger',icon:'!',title:'Remove media asset?',message:'This image or video will disappear from the current prototype session.',details:`<b>${c.querySelector('.media-name').textContent}</b><br><span>${c.dataset.type}</span>`,confirmText:'Remove media',cancelText:'Keep media'});if(ok){c.remove();note('Media removed.')}};c.querySelector('.media-edit').onclick=async()=>{const x=await AdminUI.prompt({icon:'✎',title:'Rename media',message:'Choose the display name used inside the administration panel.',inputLabel:'Display name',defaultValue:c.querySelector('.media-name').textContent,confirmText:'Save name'});if(x){c.querySelector('.media-name').textContent=x;note('Media renamed.')}};c.querySelector('.media-cover').onclick=()=>note(`${c.querySelector('.media-name').textContent} marked as cover in this prototype.`)}document.querySelectorAll('.admin-media-card').forEach(bind);
form.onsubmit=e=>{e.preventDefault();const name=document.querySelector('#media-name').value.trim(),c=document.createElement('article');c.className='admin-media-card';c.dataset.type=fileType;c.innerHTML=`${fileType==='Image'?`<img src="${fileData}" alt="${name}">`:'<div class="admin-video-placeholder">▶<small>VIDEO</small></div>'}<div><small class="media-type">${fileType}</small><h2 class="media-name">${name}</h2><p>${document.querySelector('#media-link').value} · frontend prototype</p><div class="admin-card-actions"><button class="media-cover">Set cover</button><button class="media-edit">Edit</button><button class="danger media-delete">Delete</button></div></div>`;grid.prepend(c);bind(c);dlg.close();note('Media added to prototype.')};function filter(){const q=document.querySelector('#media-search').value.toLowerCase(),t=document.querySelector('#media-filter').value;[...grid.children].forEach(c=>c.style.display=(c.textContent.toLowerCase().includes(q)&&(t==='all'||c.dataset.type===t))?'':'none')}document.querySelector('#media-search').oninput=filter;document.querySelector('#media-filter').onchange=filter;
</script></AdminLayout>
