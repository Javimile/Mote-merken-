---
import AdminLayout from '../../layouts/AdminLayout.astro'; import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
const days = Array.from({length:35},(_,i)=>i<2?'':String(i-1));
---
<AdminLayout title="Calendar & availability" active="calendar"><AdminPageHeader title="Calendar & availability" description="Enable, block or update operational dates, capacity and schedules by tour." actionLabel="Add availability" actionId="admin-add-availability" /><div class="admin-grid-2 mt-7"><section class="admin-panel"><div class="admin-panel-head"><div><p>Tour</p><h2>September 2026</h2></div><select id="calendar-tour" class="admin-inline-select"><option>Rapa Nui</option><option>Pucón</option><option>Santiago</option><option>Atacama</option></select></div><div class="admin-calendar-week"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div><div id="admin-calendar" class="admin-calendar">{days.map((d)=> d ? <button data-day={d} class:list={['admin-cal-day', [8,14,21].includes(Number(d)) && 'blocked', [4,11,18,25].includes(Number(d)) && 'reserved']}><b>{d}</b><small>{[8,14,21].includes(Number(d))?'Blocked':[4,11,18,25].includes(Number(d))?'Reserved':'Open'}</small></button> : <span></span>)}</div></section><aside class="admin-panel"><div class="admin-panel-head"><div><p>Selected date</p><h2>Availability editor</h2></div></div><form id="availability-form" class="admin-form-stack"><label><span>Date</span><input id="availability-date" value="14 September 2026" readonly /></label><label><span>Status</span><select id="availability-status"><option>Blocked</option><option>Open</option><option>Reserved</option></select></label><label><span>Capacity</span><input id="availability-capacity" type="number" min="0" value="8" /></label><label><span>Schedules</span><input id="availability-schedules" value="08:00, 12:30, 16:00" /></label><label><span>Internal note</span><textarea id="availability-note" rows="4">Operational block.</textarea></label><div class="admin-form-actions"><button class="admin-primary-btn">Save changes</button><button id="availability-delete" type="button" class="admin-danger-btn">Delete availability</button></div></form></aside></div><div id="admin-toast" class="admin-toast"></div>
<script is:inline>
const cal=document.querySelector('#admin-calendar'),toast=document.querySelector('#admin-toast');let selected=cal.querySelector('[data-day="14"]');const note=m=>{toast.textContent=m;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),1800)};function choose(b){selected=b;document.querySelector('#availability-date').value=`${b.dataset.day} September 2026`;const s=b.querySelector('small').textContent;document.querySelector('#availability-status').value=s;[...cal.querySelectorAll('.admin-cal-day')].forEach(x=>x.style.outline='none');b.style.outline='1px solid #d7b77d'}cal.querySelectorAll('.admin-cal-day').forEach(b=>b.onclick=()=>choose(b));choose(selected);document.querySelector('#availability-form').onsubmit=e=>{e.preventDefault();if(!selected)return;const s=document.querySelector('#availability-status').value;selected.classList.remove('blocked','reserved');if(s==='Blocked')selected.classList.add('blocked');if(s==='Reserved')selected.classList.add('reserved');selected.querySelector('small').textContent=s;note('Availability updated in prototype.')};document.querySelector('#availability-delete').onclick=()=>{if(!selected)return;selected.classList.remove('blocked','reserved');selected.querySelector('small').textContent='Open';document.querySelector('#availability-status').value='Open';note('Custom availability removed; date returned to Open.')};document.querySelector('#admin-add-availability').onclick=async()=>{const d=await AdminUI.prompt({icon:'□',title:'Select availability date',message:'Choose a day of September to configure in the availability editor.',inputLabel:'Day of September',inputType:'number',min:1,max:30,placeholder:'1 - 30',help:'Prototype calendar: September 2026.',confirmText:'Select date'});if(d===null)return;const b=cal.querySelector(`[data-day="${Number(d)}"]`);if(b){choose(b);note('Date selected. Configure it in the editor.')}else{await AdminUI.info({tone:'danger',icon:'!',title:'Invalid date',message:'Choose a day between 1 and 30 for this prototype calendar.',confirmText:'Got it'});}};document.querySelector('#calendar-tour').onchange=e=>note(`Calendar switched to ${e.target.value} (prototype data).`);
</script></AdminLayout>
