---
import AdminLayout from '../../layouts/AdminLayout.astro'; import AdminPageHeader from '../../components/admin/AdminPageHeader.astro'; import { adminDestinations } from '../../data/admin';
---
<AdminLayout title="Destinations" active="destinations">
  <AdminPageHeader title="Destinations" description="Manage the places available across tours and experiences." actionLabel="Add destination" actionId="admin-add-destination" />
  <section id="destination-grid" class="admin-card-grid mt-7">
    {adminDestinations.map((d)=><article class="admin-destination-card" data-id={d.id} data-active="true"><div class="admin-destination-thumb"><span>{d.name.slice(0,2).toUpperCase()}</span></div><div><small>{d.id}</small><h2 class="destination-name">{d.name}</h2><p><span class="destination-slug">/{d.slug}</span> · {d.tours} tours</p><div class="admin-card-actions"><button class="destination-edit">Edit</button><button class="destination-toggle">Deactivate</button><button class="danger destination-delete">Delete</button></div></div></article>)}
  </section>
  <dialog id="destination-dialog" class="admin-modal"><form id="destination-form"><div class="admin-modal-head"><div><p>Destination management</p><h2 id="destination-title">Add destination</h2></div><button type="button" data-close class="admin-modal-close">×</button></div><div class="admin-modal-body"><div class="admin-form-grid"><label class="admin-field"><span>Name</span><input id="destination-name" required /></label><label class="admin-field"><span>Slug</span><input id="destination-slug" required /></label><label class="admin-field full"><span>Description</span><textarea id="destination-description" rows="4" required></textarea></label><label class="admin-field"><span>Region / area</span><input id="destination-region" placeholder="Araucanía / Easter Island..." /></label><label class="admin-field"><span>Status</span><select id="destination-status"><option>Active</option><option>Inactive</option></select></label><label class="admin-field full"><span>Cover image</span><input id="destination-image" type="file" accept="image/*" /></label><div id="destination-preview" class="admin-image-preview full">Choose an image to preview</div></div></div><div class="admin-modal-actions"><button type="button" data-close class="admin-secondary-btn">Cancel</button><button class="admin-primary-btn">Save destination</button></div></form></dialog><div id="admin-toast" class="admin-toast"></div>
  <script is:inline>
    const dlg=document.querySelector('#destination-dialog'),form=document.querySelector('#destination-form'),grid=document.querySelector('#destination-grid'),toast=document.querySelector('#admin-toast');let edit=null,img='',n=5;const slug=v=>v.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');const note=m=>{toast.textContent=m;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),2000)};
    function reset(){form.reset();edit=null;img='';document.querySelector('#destination-title').textContent='Add destination';document.querySelector('#destination-preview').innerHTML='Choose an image to preview'}
    document.querySelector('#admin-add-destination').onclick=()=>{reset();dlg.showModal()};document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>dlg.close());document.querySelector('#destination-name').oninput=e=>{if(!edit)document.querySelector('#destination-slug').value=slug(e.target.value)};document.querySelector('#destination-image').onchange=e=>{const f=e.target.files?.[0];if(!f)return;const r=new FileReader();r.onload=()=>{img=r.result;document.querySelector('#destination-preview').innerHTML=`<img src="${img}">`};r.readAsDataURL(f)};
    function bind(c){c.querySelector('.destination-edit').onclick=()=>{edit=c;document.querySelector('#destination-title').textContent='Edit destination';document.querySelector('#destination-name').value=c.querySelector('.destination-name').textContent;document.querySelector('#destination-slug').value=c.querySelector('.destination-slug').textContent.slice(1);document.querySelector('#destination-description').value='Editable destination description.';document.querySelector('#destination-status').value=c.dataset.active==='true'?'Active':'Inactive';const i=c.querySelector('img');if(i)document.querySelector('#destination-preview').innerHTML=`<img src="${i.src}">`;dlg.showModal()};c.querySelector('.destination-toggle').onclick=()=>{const a=c.dataset.active==='true';c.dataset.active=String(!a);c.querySelector('.destination-toggle').textContent=a?'Activate':'Deactivate';c.style.opacity=a?'.48':'1';note(`Destination ${a?'deactivated':'activated'}.`)};c.querySelector('.destination-delete').onclick=async()=>{const ok=await AdminUI.confirm({tone:'danger',icon:'!',title:'Delete destination?',message:'The destination will be removed from this prototype session. Tours linked to it will be validated by Django later.',details:`<b>${c.querySelector('.destination-name').textContent}</b><br><span>${c.dataset.id}</span>`,confirmText:'Delete destination',cancelText:'Keep destination'});if(ok){c.remove();note('Destination deleted.')}}}document.querySelectorAll('.admin-destination-card').forEach(bind);
    form.onsubmit=e=>{e.preventDefault();const name=document.querySelector('#destination-name').value.trim(),sl=document.querySelector('#destination-slug').value.trim(),active=document.querySelector('#destination-status').value==='Active';if(edit){edit.querySelector('.destination-name').textContent=name;edit.querySelector('.destination-slug').textContent='/'+sl;edit.dataset.active=String(active);if(img){edit.querySelector('.admin-destination-thumb').innerHTML=`<img src="${img}">`;}edit.style.opacity=active?'1':'.48';note('Destination updated.')}else{const id=`DES-${String(n++).padStart(4,'0')}`,a=document.createElement('article');a.className='admin-destination-card';a.dataset.id=id;a.dataset.active=String(active);a.innerHTML=`<div class="admin-destination-thumb">${img?`<img src="${img}">`:`<span>${name.slice(0,2).toUpperCase()}</span>`}</div><div><small>${id}</small><h2 class="destination-name">${name}</h2><p><span class="destination-slug">/${sl}</span> · 0 tours</p><div class="admin-card-actions"><button class="destination-edit">Edit</button><button class="destination-toggle">${active?'Deactivate':'Activate'}</button><button class="danger destination-delete">Delete</button></div></div>`;if(!active)a.style.opacity='.48';grid.prepend(a);bind(a);note('Destination added.')}dlg.close()};
  </script>
</AdminLayout>
