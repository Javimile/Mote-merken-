---
import AdminLayout from '../../layouts/AdminLayout.astro'; import AdminPageHeader from '../../components/admin/AdminPageHeader.astro'; import { adminReservations } from '../../data/admin';
---
<AdminLayout title="Reservations" active="bookings">
  <AdminPageHeader title="Reservations" description="Review dates, travellers and reservation status. Prototype actions work immediately in the browser and will later map to Django endpoints." />
  <div class="admin-panel mt-7"><div class="admin-toolbar"><input id="booking-search" placeholder="Search reservation or traveller..."/><select id="booking-filter"><option value="all">All statuses</option><option>Pending approval</option><option>Approved</option><option>Paid</option><option>Cancelled</option><option>Expired</option></select></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Reservation</th><th>Traveller</th><th>Tour</th><th>Date</th><th>Status</th><th>Actions</th></tr></thead><tbody id="booking-body">{adminReservations.map((r)=><tr data-status={r.status}><td>{r.id}</td><td><b class="booking-traveller">{r.traveller}</b></td><td class="booking-tour">{r.tour}</td><td class="booking-date">{r.date}</td><td><span class:list={['admin-status booking-status', r.status.includes('Pending')?'pending':r.status==='Paid'?'paid':'approved']}>{r.status}</span></td><td><div class="admin-row-actions"><button class="booking-view">View</button><button class="booking-date-btn">Change date</button><button class="booking-approve">Approve</button><button class="danger booking-cancel">Cancel</button></div></td></tr>)}</tbody></table></div></div>
  <dialog id="booking-dialog" class="admin-modal"><div class="admin-modal-head"><div><p>Reservation details</p><h2 id="booking-dialog-id">Reservation</h2></div><button class="admin-modal-close" type="button" data-close>×</button></div><div class="admin-modal-body"><div class="admin-form-grid"><label class="admin-field"><span>Traveller</span><input id="booking-view-traveller" readonly/></label><label class="admin-field"><span>Tour</span><input id="booking-view-tour" readonly/></label><label class="admin-field"><span>Date</span><input id="booking-view-date" readonly/></label><label class="admin-field"><span>Status</span><input id="booking-view-status" readonly/></label><label class="admin-field full"><span>Prototype note</span><textarea rows="3" readonly>Payment, passengers and approval-deadline data will come from Django/MongoDB later.</textarea></label></div></div><div class="admin-modal-actions"><button class="admin-primary-btn" type="button" data-close>Close</button></div></dialog><div id="admin-toast" class="admin-toast"></div>
<script is:inline>
const body=document.querySelector('#booking-body'),dlg=document.querySelector('#booking-dialog'),toast=document.querySelector('#admin-toast');const note=m=>{toast.textContent=m;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),1900)};const cls=s=>s==='Paid'?'paid':s==='Cancelled'||s==='Expired'?'cancelled':s.includes('Pending')?'pending':'approved';function setStatus(r,s){r.dataset.status=s;const x=r.querySelector('.booking-status');x.textContent=s;x.className=`admin-status booking-status ${cls(s)}`;filter();}
function bind(r){r.querySelector('.booking-view').onclick=()=>{document.querySelector('#booking-dialog-id').textContent=r.cells[0].textContent;document.querySelector('#booking-view-traveller').value=r.querySelector('.booking-traveller').textContent;document.querySelector('#booking-view-tour').value=r.querySelector('.booking-tour').textContent;document.querySelector('#booking-view-date').value=r.querySelector('.booking-date').textContent;document.querySelector('#booking-view-status').value=r.dataset.status;dlg.showModal()};r.querySelector('.booking-date-btn').onclick=async()=>{const d=await AdminUI.prompt({icon:'□',title:'Modify reservation date',message:'Enter the new requested date. The reservation will return to Pending approval.',inputLabel:'New reservation date',defaultValue:r.querySelector('.booking-date').textContent,placeholder:'e.g. 18 September 2026',confirmText:'Update date'});if(d){r.querySelector('.booking-date').textContent=d;setStatus(r,'Pending approval');note('Date changed; reservation returned to pending approval.')}};r.querySelector('.booking-approve').onclick=()=>{if(r.dataset.status==='Cancelled'){note('Cancelled reservations cannot be approved in this prototype.');return}setStatus(r,'Approved');note('Reservation approved. Webpay will be enabled by backend later.')};r.querySelector('.booking-cancel').onclick=async()=>{const ok=await AdminUI.confirm({tone:'danger',icon:'!',title:'Cancel reservation?',message:'The reservation will be marked as cancelled and will no longer continue to approval or payment.',details:`<b>${r.cells[0].textContent}</b><br><span>${r.querySelector('.booking-traveller').textContent} · ${r.querySelector('.booking-tour').textContent}</span>`,confirmText:'Cancel reservation',cancelText:'Keep reservation'});if(ok){setStatus(r,'Cancelled');note('Reservation cancelled.')}}}document.querySelectorAll('#booking-body tr').forEach(bind);document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>dlg.close());function filter(){const q=document.querySelector('#booking-search').value.toLowerCase(),s=document.querySelector('#booking-filter').value;[...body.rows].forEach(r=>r.style.display=(r.textContent.toLowerCase().includes(q)&&(s==='all'||r.dataset.status===s))?'':'none')}document.querySelector('#booking-search').oninput=filter;document.querySelector('#booking-filter').onchange=filter;
</script></AdminLayout>
