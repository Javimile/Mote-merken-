---
import AdminLayout from '../../layouts/AdminLayout.astro'; import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
const users=[['USR-0001','Emma Wilson','emma@example.com','Traveller','Active'],['USR-0002','Thomas Reed','thomas@example.com','Traveller','Active'],['USR-ADM-01','Mote Merkén Admin','admin@motemerken.cl','Administrator','Active']];
---
<AdminLayout title="Users" active="users"><AdminPageHeader title="Users" description="Review registered travellers and administrative access." actionLabel="Add user" actionId="admin-add-user" /><div class="admin-panel mt-7"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody id="user-body">{users.map((u)=><tr data-status={u[4]}><td>{u[0]}</td><td><b class="user-name">{u[1]}</b></td><td class="user-email">{u[2]}</td><td class="user-role">{u[3]}</td><td><span class="admin-status approved user-status">{u[4]}</span></td><td><div class="admin-row-actions"><button class="user-view">View</button><button class="user-edit">Edit</button><button class="danger user-toggle">Disable</button></div></td></tr>)}</tbody></table></div></div>
<dialog id="user-dialog" class="admin-modal"><form id="user-form"><div class="admin-modal-head"><div><p>User management</p><h2 id="user-title">Add user</h2></div><button type="button" data-close class="admin-modal-close">×</button></div><div class="admin-modal-body"><div class="admin-form-grid"><label class="admin-field"><span>Full name</span><input id="user-name" required /></label><label class="admin-field"><span>Email</span><input id="user-email" type="email" required /></label><label class="admin-field"><span>Role</span><select id="user-role"><option>Traveller</option><option>Administrator</option><option>Operator</option></select></label><label class="admin-field"><span>Status</span><select id="user-status"><option>Active</option><option>Inactive</option></select></label></div></div><div class="admin-modal-actions"><button type="button" data-close class="admin-secondary-btn">Cancel</button><button class="admin-primary-btn">Save user</button></div></form></dialog><div id="admin-toast" class="admin-toast"></div>
<script is:inline>
const dlg=document.querySelector('#user-dialog'),form=document.querySelector('#user-form'),body=document.querySelector('#user-body'),toast=document.querySelector('#admin-toast');let edit=null,n=3;const note=m=>{toast.textContent=m;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),1800)};function reset(){form.reset();edit=null;document.querySelector('#user-title').textContent='Add user'}document.querySelector('#admin-add-user').onclick=()=>{reset();dlg.showModal()};document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>dlg.close());function set(r,s){r.dataset.status=s;const x=r.querySelector('.user-status');x.textContent=s;x.className=`admin-status user-status ${s==='Active'?'approved':'inactive'}`;r.querySelector('.user-toggle').textContent=s==='Active'?'Disable':'Enable'}function bind(r){r.querySelector('.user-view').onclick=()=>AdminUI.info({icon:'◎',title:r.querySelector('.user-name').textContent,message:'Registered user details',details:`<b>Email</b><br>${r.querySelector('.user-email').textContent}<br><br><b>Role</b><br>${r.querySelector('.user-role').textContent}<br><br><b>Status</b><br>${r.dataset.status}`,confirmText:'Close'});r.querySelector('.user-edit').onclick=()=>{edit=r;document.querySelector('#user-title').textContent='Edit user';document.querySelector('#user-name').value=r.querySelector('.user-name').textContent;document.querySelector('#user-email').value=r.querySelector('.user-email').textContent;document.querySelector('#user-role').value=r.querySelector('.user-role').textContent;document.querySelector('#user-status').value=r.dataset.status;dlg.showModal()};r.querySelector('.user-toggle').onclick=()=>{set(r,r.dataset.status==='Active'?'Inactive':'Active');note('User status updated.')}}document.querySelectorAll('#user-body tr').forEach(bind);form.onsubmit=e=>{e.preventDefault();const name=document.querySelector('#user-name').value,email=document.querySelector('#user-email').value,role=document.querySelector('#user-role').value,status=document.querySelector('#user-status').value;if(edit){edit.querySelector('.user-name').textContent=name;edit.querySelector('.user-email').textContent=email;edit.querySelector('.user-role').textContent=role;set(edit,status);note('User updated.')}else{const id=`USR-${String(n++).padStart(4,'0')}`,r=document.createElement('tr');r.dataset.status=status;r.innerHTML=`<td>${id}</td><td><b class="user-name">${name}</b></td><td class="user-email">${email}</td><td class="user-role">${role}</td><td><span class="admin-status user-status ${status==='Active'?'approved':'inactive'}">${status}</span></td><td><div class="admin-row-actions"><button class="user-view">View</button><button class="user-edit">Edit</button><button class="danger user-toggle">${status==='Active'?'Disable':'Enable'}</button></div></td>`;body.prepend(r);bind(r);note('User added.')}dlg.close()};
</script></AdminLayout>
