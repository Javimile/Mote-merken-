---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import { contactConfig } from '../data/contact';
---
<BaseLayout title="Contact | Mote Merkén Travel">
  <Header active="contact" />
  <ContactHero />

  <main>
    <section class="border-y border-white/10 bg-[#090e11] py-16 md:py-24">
      <div class="container-page grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-16">
        <aside>
          <p class="eyebrow">Plan with us</p>
          <h2 class="mt-4 font-serif text-4xl leading-tight md:text-5xl">Tell us what would make Chile meaningful to you.</h2>
          <p class="mt-5 max-w-md text-sm leading-7 text-white/55">Rather than starting with a fixed package, begin with the places, stories and experiences that matter to you. The final itinerary, availability and rates will later be handled by our booking system.</p>

          <div class="mt-10 space-y-3">
            <div class="contact-info-card"><span>Based in</span><strong>{contactConfig.location}</strong></div>
            <div class="contact-info-card"><span>Planning style</span><strong>Private & tailor-made</strong></div>
            <div class="contact-info-card"><span>Enquiries</span><strong>International travel</strong></div>
          </div>

          <div class="mt-8 border-l border-[#b98a48]/60 pl-5">
            <p class="text-xs font-bold uppercase tracking-[.18em] text-[#d7b77d]">{contactConfig.responseLabel}</p>
            <p class="mt-3 text-sm leading-6 text-white/50">{contactConfig.responseCopy}</p>
          </div>
        </aside>

        <div class="contact-form-shell">
          <div class="mb-8 flex items-start justify-between gap-5 border-b border-white/10 pb-6">
            <div><p class="eyebrow">Travel enquiry</p><h3 class="mt-2 font-serif text-3xl">Start planning</h3></div>
            <span class="hidden rounded-full border border-[#b98a48]/30 px-3 py-2 text-[10px] font-bold uppercase tracking-[.14em] text-[#d7b77d] sm:block">CNT-0001</span>
          </div>
          <ContactForm />
        </div>
      </div>
    </section>

    <section class="bg-[#070b0d] py-16 md:py-24">
      <div class="container-page">
        <div class="grid gap-6 md:grid-cols-3">
          <article class="contact-step"><span>01</span><h3>Share your idea</h3><p>Tell us when you are travelling, who is joining you and what you want to discover.</p></article>
          <article class="contact-step"><span>02</span><h3>Shape the journey</h3><p>Your enquiry becomes the starting point for a route designed around context, pace and local insight.</p></article>
          <article class="contact-step"><span>03</span><h3>Move to booking</h3><p>Once services and availability are confirmed, the reservation flow will handle dates, travellers and payment.</p></article>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
